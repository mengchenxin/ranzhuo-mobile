# Optional server-side model credentials for production deployment.
DEEPSEEK_API_KEY=sk-your-deepseek-key

# Comma-separated browser origins when frontend and API are on different domains.
RANZHUO_ALLOWED_ORIGINS=https://your-frontend.example.com
RANZHUO_RATE_LIMIT_PER_10_MIN=30
RANZHUO_REQUIRE_CLIENT_KEY=false

# Optional OpenAI-compatible embedding endpoint.
RANZHUO_EMBEDDING_BASE_URL=https://embedding-provider.example.com/v1
RANZHUO_EMBEDDING_API_KEY=your-embedding-key
RANZHUO_EMBEDDING_MODEL=bge-m3

# Optional deployment controls.
PORT=8787
RANZHUO_GATEWAY_HOST=0.0.0.0
VITE_GATEWAY_URL=https://your-service.onrender.com
