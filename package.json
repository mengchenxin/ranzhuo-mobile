{
  "name": "ranzhuo-mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node server/index.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "cap:add:android": "node -r ./scripts/capacitor-node-shim.cjs ./node_modules/@capacitor/cli/bin/capacitor add android",
    "cap:sync": "npm run build && node -r ./scripts/capacitor-node-shim.cjs ./node_modules/@capacitor/cli/bin/capacitor sync",
    "cap:open": "node -r ./scripts/capacitor-node-shim.cjs ./node_modules/@capacitor/cli/bin/capacitor open android",
    "cap:apk": "npm run cap:sync && cd android && gradlew.bat assembleDebug",
    "dev:full": "node scripts/dev-full.mjs",
    "gateway": "node server/index.mjs",
    "test:gateway": "node scripts/smoke-ai.mjs",
    "eval:ai": "node scripts/eval-ai.mjs",
    "eval:ai:live": "node scripts/eval-ai.mjs --live",
    "test:memory": "node scripts/memory-eval.mjs",
    "test:all": "npm run test:gateway && npm run test:memory && npm run eval:ai && npm run build"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "lucide-react": "^1.47.0",
    "mammoth": "^1.12.3",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.0"
  }
}
